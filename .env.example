# ==============================================================================
# VENTREXS AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate with your environment credentials.
# NEVER commit .env.local or raw credentials to version control.

# --- 1. APPLICATION BASE CONFIGURATION ---
NEXT_PUBLIC_APP_URL=https://ventrexs.com
NEXT_PUBLIC_AGENCY_URL=https://agency.ventrexs.com
NEXT_PUBLIC_ADMIN_URL=https://admin.ventrexs.com
NEXT_PUBLIC_DEMO_MODE=true

# --- 2. SUPABASE INFRASTRUCTURE ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- 3. PLATFORM ADMINISTRATOR IDENTITIES (SERVER-SIDE ONLY) ---
PLATFORM_ADMIN_1_EMAIL=owner1@ventrexs.com
PLATFORM_ADMIN_2_EMAIL=owner2@ventrexs.com

# --- 4. DUAL-APPROVAL DEMO OWNERS (SERVER-SIDE ONLY) ---
DEMO_OWNER_1_EMAIL=owner1@ventrexs.com
DEMO_OWNER_2_EMAIL=owner2@ventrexs.com

# --- 5. AI RECEPTIONIST & COPILOT INFERENCE (SERVER-SIDE ONLY) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- 6. SAAS SUBSCRIPTIONS & CUSTOMER PAYMENT PROVIDERS ---
# Routing
SAAS_PAYMENT_PROVIDER=razorpay
CUSTOMER_PAYMENT_PROVIDER=razorpay

# Razorpay — Ventrexs SaaS subscriptions (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe — International SaaS subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Skydo — Customer invoice / cross-border payments
SKYDO_API_KEY=
SKYDO_API_SECRET=
SKYDO_WEBHOOK_SECRET=

# --- 7. COMMUNICATIONS ENGINES ---
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Ventrexs AI <notifications@ventrexs.com>

# --- 8. GOOGLE OAUTH & CALENDAR INTEGRATIONS (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ventrexs.com/api/auth/callback/google
