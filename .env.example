# ==============================================================================
# VENTREXS AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development or deploy to your production
# environment secrets manager (e.g. Vercel, Supabase, Cloudflare, AWS SSM).
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit .env.local or raw credentials to version control.
# 2. NEVER put server-side secrets (API keys, secret keys, service role keys) in NEXT_PUBLIC_ variables.
# 3. For real production deployments, set NEXT_PUBLIC_DEMO_MODE=false.
# ==============================================================================

# --- 1. APPLICATION HOSTNAMES & CANONICAL ROUTING ---
NEXT_PUBLIC_APP_URL=https://www.ventrexs.com
NEXT_PUBLIC_AGENCY_URL=https://agency.ventrexs.com
NEXT_PUBLIC_ADMIN_URL=https://admin.ventrexs.com

# Set to false for real production (enforces real credentials & disables sandbox fallback)
NEXT_PUBLIC_DEMO_MODE=false

# Google Analytics / Google Tag GA4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-CSXL6SMYTC

# Google Ads Conversion Tracking (AW-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CHECKOUT_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# --- 2. SUPABASE PRODUCTION INFRASTRUCTURE ---
# Multi-tenant PostgreSQL database with Row-Level Security (RLS) and Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# CRITICAL: Server-only service role key (Never expose to client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- 3. PLATFORM ADMINISTRATOR IDENTITIES (SERVER-SIDE ONLY) ---
# Mandatory 2 distinct platform superadmin email addresses for dual-owner gates
PLATFORM_ADMIN_1_EMAIL=owner1@ventrexs.com
PLATFORM_ADMIN_2_EMAIL=owner2@ventrexs.com

# --- 4. DUAL-APPROVAL DEMO OWNERS (SERVER-SIDE ONLY) ---
DEMO_OWNER_1_EMAIL=owner1@ventrexs.com
DEMO_OWNER_2_EMAIL=owner2@ventrexs.com

# --- 5. AI RECEPTIONIST & COPILOT INFERENCE ENGINES (SERVER-SIDE ONLY) ---
# Google DeepMind Gemini (Primary high-throughput & voice triage)
GEMINI_API_KEY=
# OpenAI GPT-4o / Realtime (Secondary fallback)
OPENAI_API_KEY=
# Anthropic Claude 3.5 Sonnet (Complex reasoning & audit analysis)
ANTHROPIC_API_KEY=

# --- 6. SAAS SUBSCRIPTIONS & CUSTOMER PAYMENT PROVIDERS ---
# Routing selectors: 'razorpay' | 'stripe' | 'google_play' | 'skydo' | 'demo'
SAAS_PAYMENT_PROVIDER=razorpay
CUSTOMER_PAYMENT_PROVIDER=razorpay

# Set to false to bypass the subscription paywall for local testing
NEXT_PUBLIC_ENABLE_PAYWALL=true

# Razorpay — Ventrexs SaaS subscriptions & UPI contractor invoice payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe — International SaaS subscriptions & customer cards
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Play Billing — Android In-App Digital Subscriptions
GOOGLE_PLAY_PACKAGE_NAME=com.ventrexs.app
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=

# Skydo — B2B Cross-Border contractor invoice settlements
SKYDO_API_KEY=
SKYDO_API_SECRET=
SKYDO_WEBHOOK_SECRET=

# --- 7. OMNI-CHANNEL COMMUNICATIONS ENGINES (SERVER-SIDE ONLY) ---
# SMS Dispatch (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Meta Cloud API (Official Business Gateway)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Email Dispatch (Resend)
RESEND_API_KEY=
EMAIL_FROM=Ventrexs AI <notifications@ventrexs.com>

# --- 8. GOOGLE OAUTH & CALENDAR INTEGRATIONS (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ventrexs.com/api/auth/callback/google
