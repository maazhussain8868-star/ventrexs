# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage

# next.js build outputs
/.next/
.next/
/out/
/build

# environment files (strictly never commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.staging
.env*
!.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# security & keys
*.pem
*.key
*.cert
*.crt

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# vercel & build caches
.vercel
*.tsbuildinfo
next-env.d.ts
